@mode(host.dual)

# Unit tests for uniq's argument parsing (cli.args): defaults, flags,
# --all-repeated and --group methods, operands, the obsolete `-N` and
# `+N` forms, bad counts and the usage errors.
#
# Runtime: host.dual, run by the test runner: `make test` interprets this
# file with Stage0 (`loup-bootstrap test --no-parallel`, source/ on
# LOUPPATH), one test per `func test_*()`. It is not part of the binary.

from debug.assert import (expect, expectEq);
from cli.args import (Options, parse_args, DELIMIT_NONE, DELIMIT_PREPEND, DELIMIT_SEPARATE, GROUP_NONE, GROUP_SEPARATE, GROUP_BOTH);
from cli.numbers import (MAX_SIZE);

func parse(argv: list[string]): Options {
    return parse_args(argv).unwrap();
}

func error_of(argv: list[string]): string {
    return parse_args(argv).unwrap_err();
}

func test_defaults(): void {
    let none: list[string] = [];
    let o = parse(none);
    expect(o.output_unique and o.output_first_repeated and !o.output_later_repeated, "print every group once");
    expect(!o.count and !o.ignore_case, "no flags");
    expectEq(o.skip_fields, 0, "no fields skipped");
    expectEq(o.check_chars, MAX_SIZE, "compare everything");
    expectEq(o.delimiter, 10, "newline");
    expectEq(o.input, "-", "stdin");
    expectEq(o.output, "-", "stdout");
}

func test_flags(): void {
    let o = parse(["-cdi", "-u", "-z", "-f", "2", "-s3", "--check-chars=4"]);
    expect(o.count and o.ignore_case, "-c -i");
    expect(!o.output_unique and !o.output_first_repeated, "-d -u");
    expectEq(o.delimiter, 0, "-z");
    expectEq(o.skip_fields, 2, "-f");
    expectEq(o.skip_chars, 3, "-s");
    expectEq(o.check_chars, 4, "-w");
}

func test_all_repeated_and_group(): void {
    let d = parse(["-D"]);
    expect(d.output_later_repeated and !d.output_unique, "-D");
    expectEq(d.delimit, DELIMIT_NONE, "no separators");
    expectEq(parse(["--all-repeated=prepend"]).delimit, DELIMIT_PREPEND, "prepend");
    expectEq(parse(["--all-repeated=sep"]).delimit, DELIMIT_SEPARATE, "abbreviated");
    expectEq(parse(["--group"]).grouping, GROUP_SEPARATE, "--group");
    expectEq(parse(["--group=both"]).grouping, GROUP_BOTH, "--group=both");
    expectEq(parse(["-c"]).grouping, GROUP_NONE, "no grouping");
}

func test_operands(): void {
    let o = parse(["in.txt", "-c", "out.txt"]);
    expectEq(o.input, "in.txt", "input");
    expectEq(o.output, "out.txt", "output after an option");
    expectEq(error_of(["a", "b", "c"]), "extra operand 'c'", "three files");
    expectEq(error_of(["a", "b", "c", "-x"]), "extra operand 'c'", "reported where it occurs");
    expectEq(parse(["--", "+2"]).input, "+2", "after -- it is a file");
}

func test_obsolete_forms(): void {
    expectEq(parse(["-2"]).skip_fields, 2, "-N");
    expectEq(parse(["-1", "-2"]).skip_fields, 12, "digits accumulate");
    expectEq(parse(["-f", "3", "-2"]).skip_fields, 2, "-f then -N starts over");
    expectEq(parse(["-2", "-f", "3"]).skip_fields, 3, "-N then -f");
    expectEq(parse(["+4"]).skip_chars, 4, "+N");
    expectEq(parse(["+4", "x"]).input, "x", "+N is not a file");
}

func test_count_problems(): void {
    expectEq(parse(["-f", "x"]).problem, "x: invalid number of fields to skip", "-f");
    expectEq(parse(["-s", "-1"]).problem, "-1: invalid number of bytes to skip", "-s");
    expectEq(parse(["-w", ""]).problem, ": invalid number of bytes to compare", "-w");
    expectEq(parse(["-f", "x", "-q"]).problem, "x: invalid number of fields to skip", "before a later error");
}

func test_usage_errors(): void {
    expectEq(error_of(["-q"]), "invalid option -- 'q'", "getopt");
    expectEq(error_of(["--group", "-c"]), "--group is mutually exclusive with -c/-d/-D/-u", "group");
    expectEq(error_of(["-D", "-c"]), "printing all duplicated lines and repeat counts is meaningless", "-Dc");
    expectEq(error_of(["--group=x"]), "invalid argument 'x' for '--group'\nValid arguments are:\n  - 'prepend'\n  - 'append'\n  - 'separate'\n  - 'both'", "bad method");
    expect(parse(["--help", "-q"]).help, "--help first");
}

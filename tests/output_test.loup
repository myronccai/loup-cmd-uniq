@mode(host.dual)

# Unit tests for the parts of commands.output that do not call C: the
# count column and the UTF-8 check. Writing through C is covered by
# tests/e2e.sh against the native binary.
#
# Runtime: host.dual, run by the test runner: `make test` interprets this
# file with Stage0 (`loup-bootstrap test --no-parallel`, source/ on
# LOUPPATH), one test per `func test_*()`. It is not part of the binary.

from debug.assert import (expect, expectEq);
from commands.output import (append_count, is_utf8);

func test_append_count(): void {
    var out: list[int] = [];
    append_count(42, edits: out);
    expectEq(bytesFromInts(out).decode(), "     42 ", "%7d and a space");
    var wide: list[int] = [];
    append_count(123456789, edits: wide);
    expectEq(bytesFromInts(wide).decode(), "123456789 ", "wider than 7");
    var zero: list[int] = [];
    append_count(0, edits: zero);
    expectEq(bytesFromInts(zero).decode(), "      0 ", "zero has one digit");
}

func test_is_utf8(): void {
    expect(is_utf8([97, 195, 169, 0]), "ASCII, é and NUL");
    expect(!is_utf8([97, 255]), "stray byte");
    expect(!is_utf8([226, 130]), "truncated");
    expect(!is_utf8([237, 160, 128]), "surrogate");
}

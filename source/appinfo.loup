@mode(host.dual)

# Application identity for uniq: name, version, summary and exit statuses.
# Keep APP_NAME and APP_VERSION in step with `name` and `version` in
# package.lppkg.
#
# Runtime: host.dual. Constants only. Compiled into build/uniq by `make
# build`; `loup run source/main.loup` interprets the same code.

pub const APP_NAME: string = "uniq";
pub const APP_VERSION: string = "0.1.0";
pub const APP_SUMMARY: string = "Report or omit repeated lines (a Loup recreation of GNU uniq).";

# Exit statuses returned by main(). GNU uniq reports usage errors with 1,
# the same status as a file it cannot read or write.
pub const EXIT_OK: int = 0;
pub const EXIT_FAILURE: int = 1;
pub const EXIT_USAGE: int = 1;

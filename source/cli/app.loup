@mode(host.dual)

# Top level of uniq: parse the arguments, handle --help and --version,
# report a bad count, run the command and turn the outcome into an exit
# status (1 for every error, as GNU uniq does).
#
# Runtime: host.dual. Compiled into the native binary build/uniq by `make
# build`; `loup run source/main.loup` interprets the same code, and the unit
# tests call run() directly (never on standard input).

from appinfo import (APP_NAME, EXIT_OK, EXIT_FAILURE, EXIT_USAGE);
from cli.args import (parse_args);
from cli.usage import (usage, version_line);
from commands.uniq import (run_uniq);

# Parses argv, runs uniq and returns the exit status.
pub func run(argv: list[string]): int {
    let opts = match parse_args(argv) {
        Ok(parsed) => parsed,
        Err(msg) => {
            printErr(i"{$ APP_NAME $}: {$ msg $}");
            printErr(i"Try '{$ APP_NAME $} --help' for more information.");
            return EXIT_USAGE;
        },
    };

    if (opts.help) {
        println(usage());
        return EXIT_OK;
    }
    if (opts.version) {
        println(version_line());
        return EXIT_OK;
    }
    # A bad count (-f, -s, -w) is reported without the "Try" line.
    if (opts.problem.len() > 0) {
        printErr(i"{$ APP_NAME $}: {$ opts.problem $}");
        return EXIT_FAILURE;
    }

    try {
        return run_uniq(opts);
    } catch (Exception as e) {
        printErr(i"{$ APP_NAME $}: {$ e.message $}");
        return EXIT_FAILURE;
    }
}

@mode(host.dual)

# Text in messages, quoted the way the GNU coreutils quote it.
#
# - quote(): gnulib's quote() in the C locale, for option values and
#   operands: single quotes, with a backslash before `\` and `'` and C
#   escapes for control characters.
# - quote_name(): gnulib's "shell-escape" style (quotef), for file names: a
#   plain name as it is, one with shell metacharacters in single quotes
#   (double quotes if it has a `'` and nothing that needs escaping), and
#   control characters as $'\t' or $'\NNN'.
# - quote_always(): the "shell-escape-always" style (quoteaf): the same,
#   but always quoted.
# Characters outside ASCII are written as they are, as in a UTF-8 locale.
#
# Runtime: host.dual. Compiled into the native binary build/uniq by `make
# build`; `loup run source/main.loup` interprets the same code.

# Characters that make a name need quotes anywhere in it.
const SPECIAL: string = " !\"$&()*;<=>?[\\^`|'";

func code_of(ch: string): int {
    match char.fromString(ch) {
        Some(c) => {
            return c.toInt();
        },
        None => {
            return -1;
        },
    }
    return -1;
}

func is_control(ch: string): bool {
    if (ch.byteLength() != 1) {
        return false;
    }
    let code = code_of(ch);
    return (code >= 0 and code < 32) or code == 127;
}

func octal3(n: int): string {
    let digits = "01234567";
    let a = (n / 64) % 8;
    let b = (n / 8) % 8;
    let c = n % 8;
    return digits.slice(a, a + 1) + digits.slice(b, b + 1) + digits.slice(c, c + 1);
}

# The C escape for a control character, without the backslash.
func control_escape(ch: string): string {
    let code = code_of(ch);
    if (code == 7) {
        return "a";
    }
    if (code == 8) {
        return "b";
    }
    if (code == 9) {
        return "t";
    }
    if (code == 10) {
        return "n";
    }
    if (code == 11) {
        return "v";
    }
    if (code == 12) {
        return "f";
    }
    if (code == 13) {
        return "r";
    }
    return octal3(code);
}

pub func quote(text: string): string {
    var out: list[string] = ["'"];
    for (ch in text) {
        if (ch == "\\") {
            out.push("\\\\");
        } else if (ch == "'") {
            out.push("\\'");
        } else if (is_control(ch)) {
            out.push("\\" + control_escape(ch));
        } else {
            out.push(ch);
        }
    }
    out.push("'");
    return out.join("");
}

func needs_quotes(name: string): bool {
    if (name.len() == 0 or name == "{" or name == "}") {
        return true;
    }
    if (name.startsWith("#") or name.startsWith("~")) {
        return true;
    }
    for (ch in name) {
        if (SPECIAL.contains(ch) or is_control(ch)) {
            return true;
        }
    }
    return false;
}

# `name` in quotes: double quotes when it has a `'` and nothing a shell
# would expand, else single quotes with $'...' for control characters.
func quoted(name: string): string {
    var has_control = false;
    var double_ok = true;
    for (ch in name) {
        if (is_control(ch)) {
            has_control = true;
        }
        if ("$`\\\"!".contains(ch)) {
            double_ok = false;
        }
    }
    if (name.contains("'") and double_ok and !has_control) {
        return "\"" + name + "\"";
    }
    var out: list[string] = ["'"];
    for (ch in name) {
        if (ch == "'") {
            out.push("'\\''");
        } else if (is_control(ch)) {
            out.push("'$'\\" + control_escape(ch) + "''");
        } else {
            out.push(ch);
        }
    }
    out.push("'");
    return out.join("");
}

pub func quote_name(name: string): string {
    if (!needs_quotes(name)) {
        return name;
    }
    return quoted(name);
}

pub func quote_always(name: string): string {
    return quoted(name);
}

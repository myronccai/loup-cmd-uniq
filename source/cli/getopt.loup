@mode(host.dual)

# A small work-alike of GNU getopt_long, which the coreutils use to read
# their options. Loup 1.26 has no CLI library, so this is written by hand.
#
# The rules are getopt_long's:
# - Three orderings, as in getopt: PERMUTE (options and operands mixed, the
#   default), REQUIRE_ORDER (getopt's "+": the first operand ends the
#   options) and RETURN_IN_ORDER (getopt's "-", which uniq uses: operands
#   are reported among the options, in order, with the key OPERAND).
#   `--` always ends the options, and `-` on its own is an operand.
# - Short options cluster (`-cd`). A short option that takes a value uses
#   the rest of its argument, or else the next argument (`-f2`, `-f 2`).
# - Long options take `--name=value` or `--name value` and may be shortened
#   to any unambiguous prefix; an exact name always wins. An optional value
#   is only taken from `--name=value`.
# - Scanning stops at the `help` and `version` keys, so that, as with
#   getopt, `--help` wins over any error that comes after it.
# - An error stops the scan: the options before it are kept, so that the
#   caller can act on them first, in order, as getopt's caller would.
# Errors are getopt's messages, without the program name.
#
# Runtime: host.dual. Compiled into the native binary build/uniq by `make
# build`; `loup run source/main.loup` interprets the same code.
#
# Field names are unique across the program's structs: the native build
# lays out struct fields by name, program-wide (see NATIVE-NOTES.md).

pub const PERMUTE: int = 0;
pub const REQUIRE_ORDER: int = 1;
pub const RETURN_IN_ORDER: int = 2;

# How an option takes a value.
pub const NO_VALUE: int = 0;
pub const NEEDS_VALUE: int = 1;
pub const MAY_HAVE_VALUE: int = 2;

# The key of an operand reported in RETURN_IN_ORDER mode.
pub const OPERAND: string = "";

# One option: its letter ("" if none), its long name without dashes ("" if
# none), how it takes a value, and the key reported when it is seen.
pub struct OptSpec {
    pub letter: string;
    pub long_name: string;
    pub value_mode: int;
    pub key: string;
}

# One option found on the command line, with its value ("" if none).
pub struct OptHit {
    pub hit_key: string;
    pub hit_value: string;
    pub hit_has_value: bool;
}

# The options in the order they were given, the operands, and the error
# that stopped the scan ("" if none).
pub struct Scan {
    pub hits: list[OptHit];
    pub operands: list[string];
    pub scan_error: string;
}

# Shorthand for an OptSpec.
pub func opt(letter: string, long_name: string, value_mode: int, key: string): OptSpec {
    return OptSpec(letter = letter, long_name = long_name, value_mode = value_mode, key = key);
}

func is_stop(key: string): bool {
    return key == "help" or key == "version";
}

func done(hits: list[OptHit], operands: list[string], error: string): Scan {
    return Scan(hits = hits, operands = operands, scan_error = error);
}

func hit(key: string, value: string, has_value: bool): OptHit {
    return OptHit(hit_key = key, hit_value = value, hit_has_value = has_value);
}

# The index of the spec with letter `letter`, or -1.
func find_short(letter: string, specs: list[OptSpec]): int {
    var i = 0;
    while (i < specs.len()) {
        if (specs[i].letter.len() > 0 and specs[i].letter == letter) {
            return i;
        }
        i += 1;
    }
    return -1;
}

# The indexes of the specs whose long name starts with `name`, or only the
# exact match when there is one.
func find_long(name: string, specs: list[OptSpec]): list[int] {
    var found: list[int] = [];
    var i = 0;
    while (i < specs.len()) {
        let long_name = specs[i].long_name;
        if (long_name.len() > 0) {
            if (long_name == name) {
                return [i];
            }
            if (long_name.startsWith(name)) {
                found.push(i);
            }
        }
        i += 1;
    }
    return found;
}

pub func scan_options(argv: list[string], specs: list[OptSpec], ordering: int): Scan {
    var hits: list[OptHit] = [];
    var operands: list[string] = [];
    var i = 0;
    while (i < argv.len()) {
        let arg = argv[i];
        i += 1;

        if (arg == "--") {
            while (i < argv.len()) {
                operands.push(argv[i]);
                i += 1;
            }
            break;
        }

        if (arg.len() < 2 or !arg.startsWith("-")) {
            if (ordering == RETURN_IN_ORDER) {
                hits.push(hit(OPERAND, arg, true));
                continue;
            }
            operands.push(arg);
            if (ordering == REQUIRE_ORDER) {
                while (i < argv.len()) {
                    operands.push(argv[i]);
                    i += 1;
                }
                break;
            }
            continue;
        }

        if (arg.startsWith("--")) {
            let body = arg.slice(2);
            let eq = body.index_of("=");
            let name = if (eq >= 0) { body.slice(0, eq) } else { body };
            let found = find_long(name, specs);
            if (found.len() == 0) {
                return done(hits, operands, i"unrecognized option '{$ arg $}'");
            }
            if (found.len() > 1) {
                var names: list[string] = [];
                for (k in found) {
                    names.push("'--" + specs[k].long_name + "'");
                }
                return done(hits, operands, i"option '{$ arg $}' is ambiguous; possibilities: {$ names.join(" ") $}");
            }
            let spec = specs[found[0]];
            var value = "";
            var has_value = false;
            if (spec.value_mode == NEEDS_VALUE) {
                if (eq >= 0) {
                    value = body.slice(eq + 1);
                } else if (i < argv.len()) {
                    value = argv[i];
                    i += 1;
                } else {
                    return done(hits, operands, i"option '--{$ spec.long_name $}' requires an argument");
                }
                has_value = true;
            } else if (eq >= 0) {
                if (spec.value_mode == NO_VALUE) {
                    return done(hits, operands, i"option '--{$ spec.long_name $}' doesn't allow an argument");
                }
                value = body.slice(eq + 1);
                has_value = true;
            }
            hits.push(hit(spec.key, value, has_value));
            if (is_stop(spec.key)) {
                return done(hits, operands, "");
            }
            continue;
        }

        # A cluster of short options.
        var letters: list[string] = [];
        for (ch in arg) {
            letters.push(ch);
        }
        var j = 1;
        while (j < letters.len()) {
            let letter = letters[j];
            j += 1;
            let k = find_short(letter, specs);
            if (k < 0) {
                return done(hits, operands, i"invalid option -- '{$ letter $}'");
            }
            let spec = specs[k];
            var value = "";
            var has_value = false;
            if (spec.value_mode == NEEDS_VALUE) {
                if (j < letters.len()) {
                    value = arg.slice(j);
                    j = letters.len();
                } else if (i < argv.len()) {
                    value = argv[i];
                    i += 1;
                } else {
                    return done(hits, operands, i"option requires an argument -- '{$ letter $}'");
                }
                has_value = true;
            }
            hits.push(hit(spec.key, value, has_value));
            if (is_stop(spec.key)) {
                return done(hits, operands, "");
            }
        }
    }
    return done(hits, operands, "");
}
